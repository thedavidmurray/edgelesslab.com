{
  "name": "typed-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:effect --external:@modelcontextprotocol/* --external:bun:sqlite --external:better-sqlite3",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.12.1",
    "effect": "3.21.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "better-sqlite3": "11.7.0",
    "esbuild": "0.24.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
