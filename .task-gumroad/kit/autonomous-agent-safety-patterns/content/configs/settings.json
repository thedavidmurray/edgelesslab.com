{
  "_comment": "Drop-in safety hook configuration for Claude Code. Merge into your existing .claude/settings.json. See README.md in this folder for instructions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/scope-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/financial-gate.py"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/reversibility-classifier.py"
          }
        ]
      }
    ]
  }
}
