# =============================================================================
# n8n AI Workflows -- environment template
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- n8n Owner Setup ---
# n8n 1.x uses owner-setup (first-run wizard) instead of basic auth.
# The deprecated N8N_BASIC_AUTH_USER / N8N_BASIC_AUTH_PASSWORD vars are gone.
# On first launch, open http://localhost:5678 and create the owner account.
# To allow multiple users later, leave user management enabled (default).
# N8N_USER_MANAGEMENT_DISABLED=false

# --- LLM API Keys (at least one required) ---
# Gemini is the default for all bundled workflows. Get a free key at
# https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Postgres (required) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=n8n

# --- Timezone (used for cron schedules) ---
GENERIC_TIMEZONE=America/Los_Angeles
TZ=America/Los_Angeles

# --- SMTP for email workflows (content-digest, youtube-monitor) ---
# Gmail users: create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
DIGEST_FROM_EMAIL=you@example.com
DIGEST_TO_EMAIL=you@example.com

# --- Telegram alerts (rss-intelligence, health-check) ---
# Create a bot via @BotFather and message it once to get your chat_id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GitHub for code review workflow (optional) ---
# Personal access token with `repo` scope.
GITHUB_TOKEN=
