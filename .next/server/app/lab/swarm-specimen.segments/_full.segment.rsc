7:["$","$1","c",{"children":[["$","div",null,{"className":"flex flex-col min-h-full","style":{"background":"var(--bg-base)"},"children":[["$","$L12",null,{}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Swarm Specimen\",\"applicationCategory\":\"Simulation\",\"operatingSystem\":\"Web\",\"description\":\"Interactive, deterministic autonomous-agent ecology simulation running entirely in the browser, built on tldraw.\",\"url\":\"https://edgelesslab.com/lab/swarm-specimen\"}"}}],["$","main",null,{"className":"pt-32 pb-20 px-6","children":["$","div",null,{"className":"max-w-[1200px] mx-auto","children":[["$","div",null,{"className":"flex items-center gap-2.5 mb-6","children":[["$","span",null,{"className":"w-1.5 h-1.5 rounded-full","style":{"background":"var(--accent)"}}],["$","span",null,{"className":"text-[11px] font-mono uppercase tracking-[0.14em]","style":{"color":"var(--text-tertiary)"},"children":"Interactive · deterministic · runs in your browser"}]]}],["$","div",null,{"className":"flex items-baseline justify-between flex-wrap gap-4 mb-4","children":[["$","h1",null,{"className":"text-5xl sm:text-6xl font-bold tracking-tight leading-[0.92]","style":{"color":"var(--text-primary)"},"children":"Swarm Specimen"}],["$","span",null,{"className":"text-xs font-mono","style":{"color":"var(--text-tertiary)"},"children":"tldraw · seed-reproducible"}]]}],["$","p",null,{"className":"max-w-[68ch] text-base leading-relaxed mb-8","style":{"color":"var(--text-secondary, var(--text-tertiary))"},"children":["We build autonomous agent swarms for a living. This is one, miniaturized and put under glass: a handful of agents, a beacon they’re trying to reach, and a few finite resources between them and it. Place a few agents, press ",["$","strong",null,{"children":"Run"}],", and watch an ecology try to coordinate before it burns out. It’s deterministic — the same seed always produces the same run — so every specimen you make is a shareable, exact artifact. The field note writes its own postmortem."]}],["$","$L18",null,{}],["$","p",null,{"className":"mt-6 text-xs font-mono max-w-[68ch] leading-relaxed","style":{"color":"var(--text-tertiary)"},"children":"Agents seek the beacon; when their energy runs low they break for a resource node. Blue explorers wander, violet optimizers beeline, green caretakers share energy with failing neighbours, orange opportunists take what they can. Coordination “emerges” when a majority converge on the beacon — but the ecology rarely all makes it. Export a specimen, or share its seed."}]]}]}],["$","$L14",null,{}]]}],[["$","script","script-0",{"src":"/_next/static/chunks/0iou_-ievqog4.js","async":true,"nonce":"$undefined"}]],["$","$L19",null,{"children":["$","$15",null,{"name":"Next.MetadataOutlet","children":"$@1a"}]}]]}]
