0:{"P":null,"c":["","blog","12-dollar-ai-operations-team",""],"q":"","i":false,"f":[[["",{"children":["blog",{"children":[["slug","12-dollar-ai-operations-team","d",["soul-memo"]],{"children":["__PAGE__",{},"$undefined","$undefined",4608]},"$undefined","$undefined",4608]},"$undefined","$undefined",4608]},"$undefined","$undefined",4624],[["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/263meemi546wk.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/chunks/07v86xn308n00.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","script","script-0",{"src":"/_next/static/chunks/2cue0t2y-yu_9.js","async":true,"nonce":"$undefined"}]],["$","html",null,{"lang":"en","suppressHydrationWarning":true,"className":"geistsans_2bcb8bf5-module__cXS-2G__variable geistmono_faf7a551-module__QmjcAW__variable h-full antialiased","children":[["$","head",null,{"children":[["$","link",null,{"rel":"dns-prefetch","href":"https://github.com"}],["$","meta",null,{"name":"referrer","content":"strict-origin-when-cross-origin"}],["$","meta",null,{"httpEquiv":"Content-Security-Policy","content":"default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' us.i.posthog.com us-assets.i.posthog.com gumroad.com https://assets.gumroad.com; connect-src 'self' us.i.posthog.com us-assets.i.posthog.com gumroad.com https://edgeless-ingest.djm-claude-assistant.workers.dev; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://assets.gumroad.com; font-src 'self' https://assets.gumroad.com; frame-src 'self' gumroad.com https://edgelessai.gumroad.com;"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n              (function() {\n                try {\n                  const theme = localStorage.getItem('edgeless-theme');\n                  const resolved = theme === 'light' || theme === 'dark' ? theme\n                    : (window.