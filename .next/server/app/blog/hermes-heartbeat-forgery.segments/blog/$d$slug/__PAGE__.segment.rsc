on-colors group-hover:text-white","style":{"color":"var(--text-primary)"},"children":"The Week Agentic Engineering's Hidden Crisis: Resource Collision"}],["$","div",null,{"className":"text-xs line-clamp-2","style":{"color":"var(--text-tertiary)","lineHeight":1.5},"children":"When N agents run in parallel they collide on ports, worktrees, databases, and token budgets — with no detection, isolation, or recovery. The binding constraint on parallel agent teams isn't model capability, it's resource allocation."}],["$","div",null,{"className":"flex items-center gap-2 mt-3","children":[["$","time",null,{"className":"text-[10px] font-mono","style":{"color":"var(--text-tertiary)"},"dateTime":"2026-08-05","children":"Aug 2026"}],["$","span",null,{"className":"text-[10px] font-mono","style":{"color":"var(--text-tertiary)"},"children":"8 min"}]]}]]}],["$","$L15","the-bottleneck-that-wasnt",{"href":"/blog/the-bottleneck-that-wasnt","className":"group block p-4 rounded-lg border transition-colors","style":{"background":"var(--bg-surface)","borderColor":"var(--border-subtle)"},"children":[["$","div",null,{"className":"text-sm font-semibold mb-1 transition-colors group-hover:text-white","style":{"color":"var(--text-primary)"},"children":"710 Tasks and the Bottleneck That Wasn't"}],["$","div",null,{"className":"text-xs line-clamp-2","style":{"color":"var(--text-tertiary)","lineHeight":1.5},"children":"My task board had 710 open items and I was sure the holdup was me — the human reviewer. Then I actually counted. My real decision queue was 69. Measure before you believe."}],["$","div",null,{"className":"flex items-center gap-2 mt-3","children":[["$","time",null,{"className":"text-[10px] font-mono","style":{"color":"var(--text-tertiary)"},"dateTime":"2026-07-16","children":"Jul 2026"}],["$","span",null,{"className":"text-[10px] font-mono","style":{"color":"var(--text-tertiary)"},"children":"5 min"}]]}]]}]]}]]}]
