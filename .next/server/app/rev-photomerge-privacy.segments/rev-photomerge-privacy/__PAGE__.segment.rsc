7:["$","section",null,{"className":"mb-10","children":[["$","h2",null,{"className":"text-lg font-semibold mb-4","style":{"color":"var(--accent)"},"children":"5. Data Retention & Security"}],["$","div",null,{"children":["$","ul",null,{"children":[["$","li",null,{"children":"We retain personal data only as long as necessary to provide the service or as required by law. You may request deletion of your data at any time."}],["$","li",null,{"children":"All data in transit is encrypted via TLS. Stored media and user data are encrypted at rest."}],["$","li",null,{"children":"We implement reasonable administrative, technical, and physical safeguards to protect your information against unauthorized access, alteration, disclosure, or destruction."}]]}]}]]}]
